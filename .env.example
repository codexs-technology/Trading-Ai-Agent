# Application
NODE_ENV=development
DEMO_MODE=true

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
NEXT_PUBLIC_APP_NAME="Codex Trading"
NEXT_PUBLIC_APP_TAGLINE="Intelligent Crypto Trading. Simplified."

# Backend
PORT=4000
API_URL=http://localhost:4000
WS_PORT=4000

# Database
DATABASE_URL="file:./dev.db"

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

# OpenAI (for AI Trading Assistant)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:3000

# Demo Credentials (for seeding)
DEMO_USER_EMAIL=demo@codextrading.local
DEMO_USER_PASSWORD=DemoPass123!
ADMIN_USER_EMAIL=admin@codextrading.local
ADMIN_USER_PASSWORD=AdminPass123!

# Market Simulator
MARKET_TICK_INTERVAL_MS=1000
MARKET_VOLATILITY=0.02
MARKET_TREND=neutral
MARKET_VOLUME_MULTIPLIER=1.0
MARKET_SPREAD_BPS=5

# Trading Fees
MAKER_FEE_BPS=10
TAKER_FEE_BPS=10

# Risk Engine
MAX_RISK_PER_TRADE_PCT=2
MAX_PORTFOLIO_CONCENTRATION_PCT=20

# Logging
LOG_LEVEL=info
LOG_FORMAT=json