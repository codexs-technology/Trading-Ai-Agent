{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@codex-trading/types/*": ["packages/types/src/*"],
      "@codex-trading/shared/*": ["packages/shared/src/*"],
      "@codex-trading/config/*": ["packages/config/src/*"],
      "@codex-trading/database/*": ["packages/database/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", "build", ".next"]
}